# ============================================================================
# FastAPI Blog 论坛 —— 环境变量模板
# ============================================================================
# 用法：复制此文件为 .env，修改对应值
#   cp .env.example .env
#   （Windows: copy .env.example .env）
#
# Django 对比：Django 的 settings.py 中用 os.getenv() 读取同样的变量
#   或使用 django-environ / python-decouple 包
#
# 注意：.env 文件绝不应该提交到 Git（已在 .gitignore 中排除）
#   因为它包含密码、密钥等敏感信息
# ============================================================================

# ── 数据库配置 ────────────────────────────────────────────
# MySQL 连接字符串（使用 aiomysql 异步驱动）
# 格式：mysql+aiomysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/fast_api_blog?charset=utf8mb4

# ── JWT 认证配置 ──────────────────────────────────────────
# SECRET_KEY：JWT 签名密钥（生产环境务必改为随机字符串！）
# 用 Python 生成随机密钥：python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=fastapi_blog_secret_key_change_me_in_production

# 加密算法（HS256 = HMAC-SHA256，对称加密）
ALGORITHM=HS256

# 访问令牌有效期（分钟），默认 30 分钟
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 刷新令牌有效期（天），默认 7 天
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 文件上传配置 ──────────────────────────────────────────
# 最大上传文件大小（字节），默认 5MB = 5 * 1024 * 1024
MAX_UPLOAD_SIZE=5242880

# ── 应用配置 ──────────────────────────────────────────────
# 应用名称（显示在 Swagger 文档 /docs 的标题栏）
APP_TITLE=FastAPI Blog 论坛

# 应用版本号
APP_VERSION=2.0.0

# 调试模式（True=开发模式，False=生产模式）
DEBUG=True