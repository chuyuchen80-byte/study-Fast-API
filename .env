# =============================================================================
# .env —— 前端环境变量（开发环境）
# =============================================================================
# Vite 只会暴露 VITE_ 前缀的变量给客户端代码
# 在代码中用 import.meta.env.VITE_API_BASE_URL 读取
#
# Django 对比：Django 的 settings.py 或 .env 文件（通过 python-decouple）

VITE_API_BASE_URL=http://127.0.0.1:8000